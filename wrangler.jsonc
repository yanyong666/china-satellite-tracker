{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-terminal",
  "main": "server/cloudflare-worker.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
